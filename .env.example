POSTGRES_DB=worth_split
POSTGRES_USER=worth_split
POSTGRES_PASSWORD=change-with-a-long-random-password
DATABASE_URL=postgres://worth_split:change-with-a-long-random-password@db:5432/worth_split
SESSION_SECRET=change-with-at-least-32-random-characters
BOOTSTRAP_EMAIL=you@example.com
BOOTSTRAP_PASSWORD=change-with-a-long-unique-password
APP_ORIGIN=https://patrimonio.example.com
API_PORT=3000
SESSION_DAYS=30
COOKIE_SECURE=true
# Outgoing e-mail (Resend SMTP). Empty SMTP_HOST disables invitations and password links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM=Worth Split <worthsplit@example.com>
# Sending budget: messages per hour overall and per recipient per day.
MAIL_HOURLY_LIMIT=50
MAIL_RECIPIENT_DAILY_LIMIT=10
# Proxies trusted for X-Forwarded-For (client IP used by rate limiting): private
# Docker networks by default, or a hop count such as 2 for Nginx Proxy Manager + web.
TRUST_PROXY=loopback,linklocal,uniquelocal
WEB_PORT=43128

# Observability: API operation logs are queued durably in PostgreSQL
# and indexed asynchronously in the bundled Elasticsearch service.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=worth-split-operation-logs
OPERATION_LOG_ENABLED=true
OPERATION_LOG_RETENTION_DAYS=180
OPERATION_LOG_OUTBOX_RETENTION_DAYS=7
OPERATION_LOG_FLUSH_INTERVAL_MS=5000
OPERATION_LOG_BATCH_SIZE=100
