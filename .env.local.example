POSTGRES_DB=worth_split
POSTGRES_USER=worth_split
POSTGRES_PASSWORD=local-development-password
DATABASE_URL=postgres://worth_split:local-development-password@db:5432/worth_split
SESSION_SECRET=local-session-secret-change-before-production-123456
BOOTSTRAP_EMAIL=local@example.com
BOOTSTRAP_PASSWORD=local-development-password
APP_ORIGIN=http://localhost:43128
API_PORT=3000
SESSION_DAYS=30
COOKIE_SECURE=false
WEB_PORT=43128
DEV_WEB_PORT=43127
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=worth-split-operation-logs
OPERATION_LOG_ENABLED=true
OPERATION_LOG_RETENTION_DAYS=180
OPERATION_LOG_OUTBOX_RETENTION_DAYS=7
OPERATION_LOG_FLUSH_INTERVAL_MS=1000
OPERATION_LOG_BATCH_SIZE=100
